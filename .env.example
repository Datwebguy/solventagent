# Copy to .env (git-ignored) and fill in. Never commit .env or paste its values anywhere.

# Any mainnet RPC. The public one works for low volume; a free Helius key is better.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Treasury wallet secret key: base58 (Phantom/Solflare "export private key") or a JSON byte array.
SOLVENT_TREASURY_SECRET=

# Hard spending caps, checked before any transaction is signed.
SOLVENT_MAX_TX_USD=5
SOLVENT_MAX_DAY_USD=10

# Written by `npm run cli usepod:register`.
# USEPOD_API_TOKEN=
# USEPOD_DEPOSIT_CODE=

# Set to 1 on the always-on machine so Solvent moves funds by itself (within the caps). Off: it only plans.
# SOLVENT_AUTOPILOT=1

# Storage: Cloudflare R2 (used instead of Vercel Blob when all five are set).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
