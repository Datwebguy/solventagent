{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keep",
      "schedule": "7 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/agent/:wallet",
      "destination": "/agent.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    }
  ]
}
