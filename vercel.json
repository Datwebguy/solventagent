{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keep",
      "schedule": "7 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/agent/:wallet",
      "destination": "/agent.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ],
  "headers": [
    {
      "source": "/api/(audit|token|books|ledger|solvency-index|seals)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(openapi.json|llms.txt)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
